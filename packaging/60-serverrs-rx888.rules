# RX-888 / RX-888 Mk2 for serverrs' native USB driver.
#
# Both ids are required. The Cypress FX3 has no boot EEPROM, so it appears as
# 04b4:00f3 on every plug-in and has no radio function until serverrs uploads
# firmware into RAM. The device then re-enumerates as 04b4:00f1.
#
# TAG+="uaccess" grants an ACL to whoever is logged in at the active seat.
# GROUP="plugdev" is the fallback for headless machines, WSL2, containers and
# systemd services. It is on its own line because udev discards a whole rule
# line when the named group does not exist. To use the fallback:
#
#   sudo groupadd -f plugdev && sudo usermod -aG plugdev "$USER"
#
# then log out and back in.
#
# Install:
#   sudo cp 60-serverrs-rx888.rules /usr/lib/udev/rules.d/
#   sudo udevadm control --reload
# then unplug and replug the receiver.

# Cypress FX3 boot ROM, before firmware upload.
SUBSYSTEM=="usb", ATTRS{idVendor}=="04b4", ATTRS{idProduct}=="00f3", ENV{SERVERRS_RX888}="1"

# Programmed receiver.
SUBSYSTEM=="usb", ATTRS{idVendor}=="04b4", ATTRS{idProduct}=="00f1", ENV{SERVERRS_RX888}="1"

ENV{SERVERRS_RX888}=="1", MODE="0660", TAG+="uaccess"
ENV{SERVERRS_RX888}=="1", GROUP="plugdev"
