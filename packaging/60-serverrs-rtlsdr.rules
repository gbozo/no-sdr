SUBSYSTEM=="usb", ATTRS{idVendor}=="1d19", ATTRS{idProduct}=="1104", ENV{SERVERRS_RTLSDR}="1"
SUBSYSTEM=="usb", ATTRS{idVendor}=="1f4d", ATTRS{idProduct}=="a803", ENV{SERVERRS_RTLSDR}="1"
SUBSYSTEM=="usb", ATTRS{idVendor}=="1f4d", ATTRS{idProduct}=="b803", ENV{SERVERRS_RTLSDR}="1"
SUBSYSTEM=="usb", ATTRS{idVendor}=="1f4d", ATTRS{idProduct}=="c803", ENV{SERVERRS_RTLSDR}="1"
SUBSYSTEM=="usb", ATTRS{idVendor}=="1f4d", ATTRS{idProduct}=="d286", ENV{SERVERRS_RTLSDR}="1"
SUBSYSTEM=="usb", ATTRS{idVendor}=="1f4d", ATTRS{idProduct}=="d803", ENV{SERVERRS_RTLSDR}="1"

# Permissions, on their own lines so a missing plugdev group cannot take the
# uaccess ACL down with it.
ENV{SERVERRS_RTLSDR}=="1", MODE="0660", TAG+="uaccess"
ENV{SERVERRS_RTLSDR}=="1", GROUP="plugdev"
