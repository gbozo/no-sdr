SUBSYSTEM=="usb", ATTRS{idVendor}=="1b80", ATTRS{idProduct}=="d39d", ENV{SERVERRS_RTLSDR}="1"
SUBSYSTEM=="usb", ATTRS{idVendor}=="1b80", ATTRS{idProduct}=="d3a4", ENV{SERVERRS_RTLSDR}="1"
