SUBSYSTEM=="usb", ATTRS{idVendor}=="15f4", ATTRS{idProduct}=="0133", ENV{SERVERRS_RTLSDR}="1"
SUBSYSTEM=="usb", ATTRS{idVendor}=="185b", ATTRS{idProduct}=="0620", ENV{SERVERRS_RTLSDR}="1"
