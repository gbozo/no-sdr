# ELAD FDM-DUO / FDM-S2 / FDM-S1 for serverrs' native USB driver.
#
# These are the receive interfaces only. An FDM-DUO's CAT port is an FTDI
# bridge and its audio port is USB audio class; those need no rule here.
#
# TAG+="uaccess" grants an ACL to whoever is logged in at the active seat.
# GROUP="plugdev" is the fallback for headless machines, WSL2, containers and
# systemd services. It is on its own line because udev discards a whole rule
# line when the named group does not exist. To use the fallback:
#
#   sudo groupadd -f plugdev && sudo usermod -aG plugdev "$USER"
#
# then log out and back in.
#
# Install:
#   sudo cp 60-serverrs-elad.rules /usr/lib/udev/rules.d/
#   sudo udevadm control --reload
# then unplug and replug the device.

SUBSYSTEM=="usb", ATTRS{idVendor}=="1721", ATTRS{idProduct}=="061a", ENV{SERVERRS_ELAD}="1"
SUBSYSTEM=="usb", ATTRS{idVendor}=="1721", ATTRS{idProduct}=="061c", ENV{SERVERRS_ELAD}="1"
SUBSYSTEM=="usb", ATTRS{idVendor}=="1721", ATTRS{idProduct}=="0610", ENV{SERVERRS_ELAD}="1"

ENV{SERVERRS_ELAD}=="1", MODE="0660", TAG+="uaccess"
ENV{SERVERRS_ELAD}=="1", GROUP="plugdev"
