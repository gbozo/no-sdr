{
  "name": "no-sdr",
  "version": "2.11.8",
  "private": true,
  "description": "Multi-user WebSDR server for RTL-SDR dongles \u2014 real-time waterfall, stereo FM, AM/SSB/CW, digital mode decoding",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "workspaces": [
    "client"
  ],
  "scripts": {
    "dev": "concurrently --raw -k \"npm run dev:rust\" \"npm run dev:client\"",
    "dev:demo": "concurrently --raw -k \"npm run dev:rust:demo\" \"npm run dev:client\"",
    "dev:rust": "cd serverrs && STATIC_DIR=../client/dist CONFIG_PATH=../config/config.yaml LOG_LEVEL=debug cargo run",
    "dev:rust:demo": "cd serverrs && STATIC_DIR=../client/dist CONFIG_PATH=../config/config.yaml NODE_SDR_DEMO=1 LOG_LEVEL=debug cargo run",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build:client && npm run build:rust",
    "build:client": "npm run build --workspace=client",
    "build:rust": "cd serverrs && cargo build --release",
    "build:rust:opus": "cd serverrs && cargo build --release --no-default-features --features opus",
    "build:rust:full": "cd serverrs && cargo build --release --all-features",
    "build:rust:native": "cd serverrs && RUSTFLAGS=\"-C target-cpu=native\" cargo build --release --all-features",
    "test:rust": "cd serverrs && cargo test",
    "start": "cd serverrs && STATIC_DIR=../client/dist CONFIG_PATH=../config/config.yaml ./target/release/serverrs",
    "start:rust": "npm run start",
    "start:demo": "cd serverrs && STATIC_DIR=../client/dist CONFIG_PATH=../config/config.yaml NODE_SDR_DEMO=1 ./target/release/serverrs",
    "start:rust:demo": "npm run start:demo",
    "clean": "rimraf client/dist serverrs/target node_modules/.cache",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^0.1.99",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "rimraf": "^6.1.3",
    "start-server-and-test": "^3.0.2",
    "wait-on": "^9.0.5"
  }
}
